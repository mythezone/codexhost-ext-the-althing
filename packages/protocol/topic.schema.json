            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dispatch Id"
        },
        "panelist_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
          "title": "Panelist Id",
          "type": "string"
        },
        "panelist_name": {
          "default": "",
          "title": "Panelist Name",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "subscription": {
          "default": "",
          "title": "Subscription",
          "type": "string"
        },
        "reasoning_effort": {
          "default": "",
          "title": "Reasoning Effort",
          "type": "string"
        },
        "role": {
          "default": "",
          "title": "Role",
          "type": "string"
        },
        "round_number": {
          "default": 1,
          "minimum": 1,
          "title": "Round Number",
          "type": "integer"
        },
        "kind": {
          "default": "analysis",
          "enum": [
            "analysis",
            "critique",
            "rebuttal",
            "verification",
            "supplement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "key_points": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Key Points",
          "type": "array"
        },
        "stance_tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Stance Tags",
          "type": "array"
        },
        "full_content": {
          "minLength": 1,
          "title": "Full Content",
          "type": "string"
        },
        "target_contribution_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
            "type": "string"
          },
          "title": "Target Contribution Ids",
          "type": "array"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "token_usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Usage"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "topic_id": {
          "type": "string"
        },
        "agenda_id": {
          "type": "string"
        },
        "sub_agenda_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "dispatch_id",
        "panelist_id",
        "panelist_name",
        "model",
        "provider",
        "subscription",
        "reasoning_effort",
        "role",
        "round_number",
        "kind",
        "summary",
        "key_points",
        "stance_tags",
        "full_content",
        "target_contribution_ids",
        "duration_ms",
        "token_usage",
        "created_at",
        "updated_at",
        "topic_id",
        "agenda_id",
        "sub_agenda_id"
      ],
      "title": "Contribution",
      "type": "object"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "subtitle": {
          "default": "",
          "title": "Subtitle",
          "type": "string"
        },
        "agenda_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
