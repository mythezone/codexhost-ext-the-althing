    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "reports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Report"
      }
    },
    "archives": {
      "type": "array",
      "items": {
