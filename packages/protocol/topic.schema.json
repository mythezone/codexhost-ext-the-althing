      "type": "object"
    },
    "Dispatch": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "round_number": {
          "default": 1,
          "minimum": 1,
          "title": "Round Number",
          "type": "integer"
        },
        "round_type": {
          "default": "opening",
          "enum": [
            "opening",
            "critique",
            "rebuttal",
            "synthesis_request",
            "custom"
          ],
          "title": "Round Type",
          "type": "string"
        },
        "moderator_name": {
          "default": "",
          "title": "Moderator Name",
          "type": "string"
        },
        "prompt_summary": {
          "title": "Prompt Summary",
          "type": "string"
        },
        "prompt_full": {
          "title": "Prompt Full",
          "type": "string"
        },
        "target_panelist_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
            "type": "string"
          },
          "title": "Target Panelist Ids",
          "type": "array"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "topic_id": {
          "type": "string"
        },
        "agenda_id": {
          "type": "string"
        },
        "sub_agenda_id": {
          "type": "string"
        },
        "contributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Contribution"
          }
        }
      },
      "required": [
        "id",
        "title",
        "round_number",
        "round_type",
        "moderator_name",
        "prompt_summary",
        "prompt_full",
        "target_panelist_ids",
        "created_at",
        "updated_at",
        "topic_id",
        "agenda_id",
        "sub_agenda_id",
        "contributions"
      ],
      "title": "Dispatch",
      "type": "object"
    },
    "Contribution": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
