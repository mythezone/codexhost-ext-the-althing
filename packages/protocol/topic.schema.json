      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "code": {
          "default": "",
          "title": "Code",
          "type": "string"
        },
        "order_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Index"
        },
        "objective": {
          "default": "",
          "title": "Objective",
          "type": "string"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "in_progress",
            "critiquing",
            "completed"
          ],
          "title": "Status",
          "type": "string"
        },
        "progress_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "current_activity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Activity"
        },
        "conclusion_summary": {
          "default": "",
          "title": "Conclusion Summary",
          "type": "string"
        },
        "conclusion_key_points": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Conclusion Key Points",
          "type": "array"
        },
        "open_disagreements": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Open Disagreements",
          "type": "array"
        },
        "report_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Id"
        },
        "sub_agendas": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SubAgenda"
          },
          "title": "Sub Agendas",
          "type": "array"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "topic_id": {
          "type": "string"
        },
        "pinned_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "progress_pct",
              "current_activity",
              "status"
            ]
          }
        }
      },
      "required": [
        "id",
        "title",
        "code",
        "order_index",
        "objective",
        "status",
        "progress_pct",
        "current_activity",
        "conclusion_summary",
        "conclusion_key_points",
        "open_disagreements",
        "report_id",
        "sub_agendas",
        "completed_at",
        "created_at",
        "updated_at",
        "topic_id"
