            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agenda Id"
        },
        "report_type": {
          "anyOf": [
            {
              "enum": [
                "agenda",
                "final",
                "custom"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Type"
        },
        "version": {
          "default": "1",
          "title": "Version",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "html",
                "markdown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "markdown_content": {
          "default": "",
          "title": "Markdown Content",
          "type": "string"
        },
        "html_content": {
          "default": "",
          "title": "Html Content",
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "topic_id": {
          "type": "string"
        },
        "source_html": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "topic_id",
        "report_type",
        "format",
        "created_at",
        "updated_at"
      ],
      "title": "Report",
      "type": "object"
    },
    "Archive": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "topic_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "format": {
          "const": "zip"
        },
        "file_name": {
          "type": "string"
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_at": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "download_url": {
          "type": "string"
        },
        "preview_url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "topic_id",
        "title",
        "format",
        "file_name",
        "file_size_bytes",
        "sha256",
        "created_at",
        "metadata",
        "download_url",
        "preview_url"
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
      "title": "Id",
      "type": "string"
