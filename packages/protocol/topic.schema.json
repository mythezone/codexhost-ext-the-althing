      "title": "Agenda",
      "type": "object"
    },
    "JsonValue": {},
    "Moderator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        }
      },
      "title": "Moderator",
      "type": "object"
    },
    "Panelist": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "default": "",
          "title": "Provider",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "subscription": {
          "default": "",
          "title": "Subscription",
          "type": "string"
        },
        "reasoning_effort": {
          "default": "",
          "title": "Reasoning Effort",
          "type": "string"
        },
        "role": {
          "default": "",
          "title": "Role",
          "type": "string"
        },
        "color_token": {
          "default": "",
          "title": "Color Token",
          "type": "string"
        }
      },
      "required": [
        "name",
        "id"
      ],
      "title": "Panelist",
      "type": "object"
    },
    "SubAgenda": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "code": {
          "default": "",
          "title": "Code",
          "type": "string"
        },
        "order_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order Index"
        },
        "prompt_framing": {
          "default": "",
          "title": "Prompt Framing",
          "type": "string"
        },
        "execution_mode": {
          "default": "parallel",
          "enum": [
            "parallel",
            "sequential"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "dispatching",
            "in_progress",
            "critiquing",
            "completed"
          ],
          "title": "Status",
          "type": "string"
        },
        "progress_pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "current_activity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Activity"
        },
        "synthesis_summary": {
          "default": "",
          "title": "Synthesis Summary",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "topic_id": {
          "type": "string"
        },
        "agenda_id": {
          "type": "string"
        },
        "dispatches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Dispatch"
          }
        },
        "contributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Contribution"
          }
        }
      },
      "required": [
        "id",
        "title",
        "code",
        "order_index",
        "prompt_framing",
        "execution_mode",
        "depends_on",
        "status",
        "progress_pct",
        "current_activity",
        "synthesis_summary",
        "completed_at",
        "created_at",
        "updated_at",
        "topic_id",
        "agenda_id",
        "dispatches",
        "contributions"
      ],
