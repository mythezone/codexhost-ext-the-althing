{
  "name": "@the-althing/codexhost-extension",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:backend": "node scripts/build.mjs --backend-only",
    "test": "npm run build && npm run pack && node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "build": "node scripts/build.mjs",
    "pack": "node --import tsx scripts/pack.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "test:mobile": "npm run build && node --import tsx --test tests/browser/mobile.test.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@streamparser/json": "^0.0.22",
    "dompurify": "^3.5.0",
    "lucide-react": "^0.544.0",
    "marked": "^16.2.0",
    "parse5": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@rollup/browser": "^4.68.8",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "codexhost-extensions-registry": "https://codeload.github.com/BytePioneer-AI/codexhost-extensions-registry/tar.gz/542262a92c2a944bbe892778ef5d667d50232d60",
    "es-module-lexer": "^3.0.5",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.14.6",
    "playwright-core": "1.61.1",
    "postcss": "^8.5.33",
    "postcss-prefix-selector": "^2.2.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
