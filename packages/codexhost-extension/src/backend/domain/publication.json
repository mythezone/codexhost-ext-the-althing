{
  "css": ":root {\n  color-scheme: light;\n  --bg: #f5f8ff; --card: #fff; --ink: #19294b; --muted: #526582;\n  --line: #d7e2f3; --accent: #2859c6; --tint: #edf4ff; --mint: #e9f8f2;\n}\n:root[data-dark] {\n  color-scheme: dark;\n  --bg: #141e34; --card: #202e49; --ink: #edf4ff; --muted: #b4c4de;\n  --line: #415373; --accent: #a1c2ff; --tint: #293c60; --mint: #233f43;\n}\n* { box-sizing: border-box }\nbody { background: var(--bg); color: var(--ink); margin: 0; font: 16px/1.7 system-ui, sans-serif }\na { color: var(--accent); text-underline-offset: .17em }\nheader { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; gap: .6rem; padding: .6rem max(4vw, 16px); background: var(--card); border-bottom: 1px solid var(--line) }\nheader strong { display: flex; gap: .45rem; align-items: center; font-size: 1.15rem; letter-spacing: -.04em; margin-right: auto; white-space: nowrap }\nheader img { width: 2.65rem; height: 2.2rem; object-fit: contain }\nbutton, summary { font: inherit; cursor: pointer }\nbutton { color: var(--ink); background: var(--card); border: 1px solid var(--line); border-radius: .8rem; padding: .4em .85em; font-size: .9rem; font-weight: 650 }\nbutton:hover, button:focus-visible { border-color: var(--accent) }\nbutton[aria-pressed=true] { background: var(--accent); color: var(--card); border-color: var(--accent) }\nmain { max-width: 1160px; margin: 2.3rem auto; padding: 0 clamp(16px, 4vw, 48px) }\n.mast { display: flex; align-items: center; justify-content: space-between; gap: 1rem; background: linear-gradient(115deg, var(--tint), var(--card) 70%, var(--mint)); border: 1px solid var(--line); border-radius: 1.5rem; padding: clamp(20px, 4vw, 44px); margin-bottom: 1.5rem; overflow-wrap: anywhere }\n.mast img { width: clamp(68px, 11vw, 124px); flex: none }\nh1,h2,h3 { line-height: 1.3; text-wrap: pretty; scroll-margin-top: 5rem }\nh1 { font-size: clamp(1.8rem, 4vw, 3.2rem); margin: .16em 0; letter-spacing: -.04em }\n.label { color: var(--accent); font-weight: 700; font-size: .9rem }\n.body, article { background: var(--card); border: 1px solid var(--line); border-radius: 1.15rem; padding: clamp(16px, 3vw, 36px) }\n.toc { margin: 0 0 1rem; border-block: 1px solid var(--line); font-size: .94rem; padding: .55rem 0 }\n.toc summary { width: fit-content; font-weight: 700 }\n.toc nav { padding: .3rem .9rem }\n.toc a { display: block; margin: .45em 0; overflow-wrap: anywhere }\n.body { min-width: 0; overflow-wrap: anywhere }\narticle { margin: .75rem 0 }\n.layout > article { margin: 0 }\n.body > :first-child { margin-top: 0 }\n.body > :last-child { margin-bottom: 0 }\n.body h2 { margin-top: 1.6em }\n.body blockquote { background: var(--tint); border-left: 3px solid var(--accent); padding: .55rem 1rem; margin: 1rem 0 }\n.body code { background: var(--tint); padding: .12em .3em; border-radius: .3em }\n.body pre { background: #1c2944; color: #eef4ff; padding: 1rem; border-radius: .75rem; overflow: auto }\n.body pre code { background: none }\n.body th, .body td { padding: .5rem .8rem; border: 1px solid var(--line); text-align: left }\n.body th { background: var(--tint) }\n.body img { max-width: 100% }\n.tabs { display: flex; gap: .45rem; flex-wrap: wrap; margin: .8rem 0 1.2rem }\n.expert { border-left: 4px solid var(--accent) }\ndetails { margin: .8rem 0 }\nsummary { color: var(--accent) }\n[hidden] { display: none !important }\n@media (max-width: 720px) {\n  main { margin-top: 1rem } header { gap: .35rem } header button { font-size: .8rem }\n}\n@media (max-width: 400px) {\n  header { padding: .5rem .7rem } header strong { font-size: 1rem } header img { width: 1.9rem }\n  .mast img { width: 52px }\n}\n@media print {\n  header, .toc, .tabs, .mast img { display: none }\n  main { max-width: none; margin: 0; padding: 0 } .layout { display: block }\n  body, article, .body, .mast { color: #000; background: white }\n  article, .mast, .body { border: 0; padding: 0 }\n  h2, h3 { break-after: avoid } pre, table, blockquote { break-inside: avoid }\n}\n",
  "book": "data:image/webp;base64,",
  "owl": "data:image/webp;base64,",
  "tableCss": ".table-scroll {\n  display: block; min-width: 0; width: 100%; max-width: 100%;\n  overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch;\n  touch-action: pan-x pan-y; overscroll-behavior-x: contain;\n  border: 1px solid var(--line); border-radius: 8px;\n}\n.table-scroll > table {\n  display: table; overflow: visible; table-layout: auto; width: max-content; min-width: 100%; border-collapse: collapse;\n}\n.table-scroll > table > :is(thead,tbody,tfoot) > tr > :is(th,td) {\n  box-sizing: border-box; min-width: 132px; max-width: 300px;\n  white-space: normal; word-break: normal; overflow-wrap: break-word; vertical-align: top;\n}\n@media screen and (max-width: 760px) {\n  .table-scroll:has(> table tr > :nth-child(3))::before {\n    content: \"↔  Swipe to see all columns\"; display: block; position: sticky; left: 0;\n    padding: 3px 8px; font-size: 12px; color: var(--muted); background: var(--card);\n  }\n  .table-scroll:lang(zh):has(> table tr > :nth-child(3))::before { content: \"↔  左右滑动查看各列\"; }\n  .table-scroll:lang(zh-TW):has(> table tr > :nth-child(3))::before { content: \"↔  左右滑動查看各欄\"; }\n  .table-scroll:lang(ja):has(> table tr > :nth-child(3))::before { content: \"↔  横にスワイプしてすべての列を表示\"; }\n  .table-scroll:lang(ko):has(> table tr > :nth-child(3))::before { content: \"↔  좌우로 밀어 모든 열 보기\"; }\n}\n@media print {\n  .table-scroll { overflow: visible; border: 0; border-radius: 0; }\n  .table-scroll > table { width: 100%; table-layout: fixed; break-inside: auto; }\n  .table-scroll > table > :is(thead,tbody,tfoot) > tr > :is(th,td) {\n    width: auto; min-width: 0; max-width: none; padding: 3pt; font-size: 9pt;\n  }\n  .table-scroll tr { break-inside: avoid; }\n}\n",
  "readerCss": "@media screen and (max-width: 680px) {\n  main { margin: 8px auto; padding-inline: 6px; }\n  .mast { padding: 12px; margin-bottom: 8px; border-radius: 10px; }\n  .body { padding: 10px; border-radius: 10px; }\n  header { flex-wrap: wrap; }\n}\nhtml { overscroll-behavior-y: contain; }\n"
}
